#!/usr/bin/env php
<?php
/*
 * E X U R A - D E V
 * The development runite of this workbench.
 *
 * `php exura` fetches exuracss, exurajs and exuraphp into src/vessel/;
 * this runite serves the playground (src/) and tests those files.
 *
 * Run this script using:
 *   $ php cast
 *   $ php cast serve --port=8080
 *   $ php cast test --css
 */
require_once __DIR__ . '/vendor/autoload.php';



/**
 * I N V O C A T I O N
 *
 * Step 1 — Summon the runes:
 * Import each module's manifest.
 *
 * Step 2 — Channel the energy:
 * Initialize ether, essence, and entity.
 *
 * Note: Keep #sentinel markers if you're using Sentinel support.
 */
use Rune\Aether\Manifest as Aether;
use Rune\Chanter\Manifest as Chanter;
use Rune\Weaver\Manifest as Weaver;
use Rune\Whisper\Manifest as Whisper;
use Rune\Forger\Manifest as Forger;
use Rune\Keeper\Manifest as Keeper;
use Rune\Specter\Manifest as Specter;
#sentinel-manifest

Aether::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Forger::ether()::essence()::entity();
Keeper::ether()::essence()::entity();
Specter::ether()::essence()::entity();
#sentinel-awaken



/**
 * E X U R A - D E V
 *
 * The settings of this runite.
 *   EXURA_DEV_HOST   where the playground is served
 *   EXURA_DEV_PORT   its port (--port changes it for one run)
 *   EXURA_DEV_SUITE  the test suites, one folder each in tests/
 */
const EXURA_DEV_HOST = 'localhost';
const EXURA_DEV_PORT = '8080';
const EXURA_DEV_SUITE = ['php', 'js', 'css', 'integration'];

// the files the playground needs, and the `php exura` cast that fetches each
const EXURA_DEV_VESSEL = [
  'exura.css'=> 'php exura css',
  'exura-clip.css'=> 'php exura css --part=clip',
  'exura.js'=> 'php exura js',
  'exura.php'=> 'php exura php',
];

// Rune ends every run with a bare `exit` (aether_exit), so the exit code is always 0.
// A cast marks a failure here; a shutdown function hands it to the shell.
$EXURA_DEV_EXIT = 0;
register_shutdown_function(function() {
  global $EXURA_DEV_EXIT;
  if ($EXURA_DEV_EXIT) exit($EXURA_DEV_EXIT);
});

function exura_dev_fail() {
  global $EXURA_DEV_EXIT;
  $EXURA_DEV_EXIT = 1;
  return false;
}

// one line of output: ok, fail or info
function exura_dev_line( String $state, String $text ) {
  $color = ['ok'=> 'success', 'fail'=> 'danger', 'info'=> 'secondary'][$state];
  $icon = ['ok'=> 'success', 'fail'=> 'danger', 'info'=> 'info'][$state];
  Whisper::echo("{{color-$color}}{{icon-$icon}}{{color-end}} $text{{nl}}");
}

// a spell with a value, or its default (a spell without a value is '1')
function exura_dev_spell( String $key, String $default ) {
  $value = Chanter::spell($key);
  return ($value === false || $value === '' || $value === '1') ? $default : trim((string) $value);
}

// the vessel folder: EXURA_DIST of the exura runite
function exura_dev_vessel() {
  preg_match("#const EXURA_DIST = '([^']*)';#", Forger::item(__DIR__ . '/exura'), $m);
  return $m[1] ?? 'src/vessel/';
}

// every Exura file fetched? otherwise say which `php exura` cast brings it
function exura_dev_ready() {
  $vessel = exura_dev_vessel();
  $ready = true;
  foreach (EXURA_DEV_VESSEL as $file => $fetch) {
    if (!is_file(__DIR__ . '/' . $vessel . $file)) {
      exura_dev_line('fail', "$vessel$file is not fetched yet — run: $fetch");
      $ready = false;
    }
  }
  return $ready;
}



/**
 * I N C A N T A T I O N
 *
 * This is your working space.
 * Use begin() and end() to define the active logic scope.
 */
Aether::begin();
Chanter::begin();
Keeper::begin();


/* I · SERVE
 * the playground (src/) with the Exura files of src/vessel/
 * $ php cast serve
 * $ php cast serve --port=9000 --public
 * */
Chanter::cast(
  arg: 'serve --port --host --public',
  echo: 'Serve the playground. --port=8080 --host=localhost --public',
  execute: function() {
    // read every spell first
    $port = exura_dev_spell('port', EXURA_DEV_PORT);
    $host = exura_dev_spell('host', EXURA_DEV_HOST);
    $public = Chanter::spell('public') !== false;
    if (!exura_dev_ready()) return exura_dev_fail();

    Specter::devserver([
      'host'=> $host,
      'port'=> $port,
      'mode'=> $public ? 'public' : 'private',
      'path'=> __DIR__ . '/src',
      'file'=> __DIR__ . '/src/router.php',
    ]);
  }
);


/* II · TEST
 * node:test + Playwright against the playground, one suite per folder of tests/
 * $ php cast test                   every suite
 * $ php cast test --css --js        some of them
 * [i]INFO: a failing test makes the run exit 1
 * */
Chanter::cast(
  arg: 'test --php --js --css --integration',
  echo: 'Test the fetched Exura files. --php --js --css --integration (none = all)',
  execute: function() {
    // read every spell first
    $suites = array_values(array_filter(EXURA_DEV_SUITE, fn($suite) => Chanter::spell($suite) !== false));
    $suites = $suites ?: EXURA_DEV_SUITE;
    if (!exura_dev_ready()) return exura_dev_fail();

    exura_dev_line('info', 'Exura of ' . exura_dev_vessel() . ' » ' . implode(', ', $suites));
    $files = implode(' ', array_map(fn($suite) => escapeshellarg("tests/$suite/**/*.test.mjs"), $suites));
    $process = proc_open("node --test --test-reporter=spec $files", [STDIN, STDOUT, STDERR], $pipes, __DIR__);
    $code = is_resource($process) ? proc_close($process) : 1;

    if ($code !== 0) {
      exura_dev_line('fail', 'Tests failed');
      return exura_dev_fail();
    }
    exura_dev_line('ok', 'Tests passed');
    return true;
  }
);


// Three files fetched by exura,
// served and tried by cast.

#sentinel-codex
Keeper::end();
Chanter::end();
Aether::end();
