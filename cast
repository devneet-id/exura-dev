#!/usr/bin/env php
<?php
/*
 * E X U R A - D E V
 * The development server of this workbench.
 *
 * `php exura` fetches exuracss, exurajs and exuraphp into core/;
 * this runite serves one folder — exploration/ or a scenario — with core/ beside it.
 *
 * Run this script using:
 *   $ php cast
 *   $ php cast exploration
 *   $ php cast scenario --name=exuracss-grid
 *   $ php cast serve --path=scenario/exurajs-counter --port=9000
 */
require_once __DIR__ . '/vendor/autoload.php';



/**
 * I N V O C A T I O N
 *
 * Step 1 — Summon the runes:
 * Import each module's manifest.
 *
 * Step 2 — Channel the energy:
 * Initialize ether, essence, and entity.
 *
 * Note: Keep #sentinel markers if you're using Sentinel support.
 */
use Rune\Aether\Manifest as Aether;
use Rune\Chanter\Manifest as Chanter;
use Rune\Weaver\Manifest as Weaver;
use Rune\Whisper\Manifest as Whisper;
use Rune\Forger\Manifest as Forger;
use Rune\Keeper\Manifest as Keeper;
use Rune\Specter\Manifest as Specter;
#sentinel-manifest

Aether::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Forger::ether()::essence()::entity();
Keeper::ether()::essence()::entity();
Specter::ether()::essence()::entity();
#sentinel-awaken



/**
 * E X U R A - D E V
 *
 * The settings of this runite.
 *   EXURA_DEV_HOST  where the folder is served
 *   EXURA_DEV_PORT  its port (--port changes it for one run)
 *   EXURA_DEV_CORE  what `php exura` puts in core/, and the cast that fetches each
 */
const EXURA_DEV_HOST = 'localhost';
const EXURA_DEV_PORT = '8080';
const EXURA_DEV_CORE = [
  'exura.css'=> 'php exura css',
  'exura-clip.css'=> 'php exura css --part=clip',
  'exura.js'=> 'php exura js',
  'exura.php'=> 'php exura php',
];

// Rune ends every run with a bare `exit` (aether_exit), so the exit code is always 0.
// A cast marks a failure here; a shutdown function hands it to the shell.
$EXURA_DEV_EXIT = 0;
register_shutdown_function(function() {
  global $EXURA_DEV_EXIT;
  if ($EXURA_DEV_EXIT) exit($EXURA_DEV_EXIT);
});

function exura_dev_fail() {
  global $EXURA_DEV_EXIT;
  $EXURA_DEV_EXIT = 1;
  return false;
}

// one line of output: ok, fail or info
function exura_dev_line( String $state, String $text ) {
  $color = ['ok'=> 'success', 'fail'=> 'danger', 'info'=> 'secondary'][$state];
  $icon = ['ok'=> 'success', 'fail'=> 'danger', 'info'=> 'info'][$state];
  Whisper::echo("{{color-$color}}{{icon-$icon}}{{color-end}} $text{{nl}}");
}

// a spell with a value, or its default (a spell without a value is '1')
function exura_dev_spell( String $key, String $default ) {
  $value = Chanter::spell($key);
  return ($value === false || $value === '' || $value === '1') ? $default : trim((string) $value);
}

// core/ filled? a missing file is only a warning: the pages that need it show it
function exura_dev_core() {
  foreach (EXURA_DEV_CORE as $file => $fetch) {
    if (!is_file(__DIR__ . "/core/$file")) {
      exura_dev_line('fail', "core/$file is missing — run: $fetch");
    }
  }
}

// every scenario: a folder of scenario/ with an index.html or index.php
function exura_dev_scenarios() {
  $list = [];
  foreach (glob(__DIR__ . '/scenario/*', GLOB_ONLYDIR) as $dir) {
    if (is_file("$dir/index.html") || is_file("$dir/index.php")) $list[] = basename($dir);
  }
  return $list;
}

// serve one folder of this repo as the site root, core/ beside it
function exura_dev_serve( String $path ) {
  // read every spell first
  $port = exura_dev_spell('port', EXURA_DEV_PORT);
  $host = exura_dev_spell('host', EXURA_DEV_HOST);
  $public = Chanter::spell('public') !== false;

  $path = trim(str_replace('\\', '/', $path), '/');
  if ($path === '' || str_contains($path, '..') || !is_dir(__DIR__ . "/$path")) {
    exura_dev_line('fail', "'$path' is not a folder of this repo, e.g. --path=exploration or --path=scenario/exuracss-grid");
    return exura_dev_fail();
  }

  exura_dev_core();
  exura_dev_line('info', "$path/ at the root, core/ as /core/");
  Specter::devserver([
    'host'=> $host,
    'port'=> $port,
    'mode'=> $public ? 'public' : 'private',
    'path'=> __DIR__ . "/$path",
    'file'=> __DIR__ . '/router.php',
  ]);
}



/**
 * I N C A N T A T I O N
 *
 * This is your working space.
 * Use begin() and end() to define the active logic scope.
 */
Aether::begin();
Chanter::begin();
Keeper::begin();


/* I · EXPLORATION
 * every component of the three packages, and a complete app
 * $ php cast exploration
 * $ php cast exploration --port=9000
 * */
Chanter::cast(
  arg: 'exploration --port --host --public',
  echo: 'Serve exploration/: every component, and the app. --port=8080',
  execute: function() {
    exura_dev_serve('exploration');
  }
);


/* II · SCENARIO
 * one possibility at a time; an error shows in the page
 * $ php cast scenario                         list them, then ask which
 * $ php cast scenario --name=exuracss-grid
 * */
Chanter::cast(
  arg: 'scenario --name --port --host --public',
  echo: 'Serve one scenario/. --name=exuracss-grid (none = list and ask)',
  execute: function() {
    // read every spell first
    $name = exura_dev_spell('name', '');
    $list = exura_dev_scenarios();

    if ($name === '') {
      foreach ($list as $i => $item) {
        Whisper::echo('{{color-info}} [' . ($i + 1) . ']{{color-end}} ' . $item . '{{nl}}');
      }
      $answer = trim((string) Whisper::call('Which scenario? [number or name]:'));
      $name = ctype_digit($answer) ? ($list[(int) $answer - 1] ?? '') : $answer;
    }
    if (!in_array($name, $list, true)) {
      exura_dev_line('fail', "'$name' is not a scenario — run: php cast scenario");
      return exura_dev_fail();
    }
    exura_dev_serve("scenario/$name");
  }
);


/* III · SERVE
 * any folder of this repo
 * $ php cast serve --path=scenario/exurajs-counter --port=9000 --public
 * */
Chanter::cast(
  arg: 'serve --path --port --host --public',
  echo: 'Serve any folder. --path=exploration --port=8080 --host=localhost --public',
  execute: function() {
    exura_dev_serve(exura_dev_spell('path', 'exploration'));
  }
);


// Three files fetched by exura into core/,
// served beside every folder by cast.

#sentinel-codex
Keeper::end();
Chanter::end();
Aether::end();
